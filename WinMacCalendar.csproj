<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
    <Product>WinMacCalendar</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources/Calendar.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);.dotnet/**;.cli/**;.nuget/**;.verify/**;publish/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CalendarChecks" />
    <Resource Include="Resources/Calendar.ico" />
    <Content Include="Resources/Fonts/*.ttf;Resources/Fonts/*.otf" Link="Fonts/%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Compile Remove="tests/**/*.cs" />
    <None Remove="tests/**" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.11" />
    <PackageReference Include="Ical.Net" Version="5.2.4" />
  </ItemGroup>
</Project>
